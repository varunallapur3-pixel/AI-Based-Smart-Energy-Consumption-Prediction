# ==============================================================================
# VOLTIX Smart Energy Platform - Backend Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="VOLTIX Smart Energy Platform Backend"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# Server Settings
HOST="0.0.0.0"
PORT=8000

# Database Settings
# For SQLite (default development):
DATABASE_URL="sqlite:///./voltix.db"
# For PostgreSQL (future production migration):
# DATABASE_URL="postgresql+psycopg2://voltix_user:secure_password@localhost:5432/voltix_db"
DB_ECHO=false

# CORS Origins (comma-separated origins allowed for cross-origin requests)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
